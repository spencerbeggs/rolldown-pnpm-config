{
	"name": "@spencerbeggs/rolldown-pnpm-config",
	"version": "0.0.0",
	"private": true,
	"description": "A template repository for developing and deploying Node.js modules from a pnpm monorepo structure.",
	"homepage": "https://github.com/spencerbeggs/rolldown-pnpm-config#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/rolldown-pnpm-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/rolldown-pnpm-config.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --passWithNoTests",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"pnpm:export:rolldown": "pnpm --filter '@example/rolldown' run pnpm:export",
		"pnpm:export:savvy": "pnpm --filter '@example/savvy' run pnpm:export",
		"pnpm:export:tsdown": "pnpm --filter '@example/tsdown' run pnpm:export",
		"pnpm:preview:rolldown": "pnpm --filter '@example/rolldown' run pnpm:preview",
		"pnpm:preview:savvy": "pnpm --filter '@example/savvy' run pnpm:preview",
		"pnpm:up:rolldown": "pnpm --filter '@example/rolldown' run pnpm:up",
		"pnpm:up:savvy": "pnpm --filter '@example/savvy' run pnpm:up",
		"pnpm:up:tsdown": "pnpm --filter '@example/tsdown' run pnpm:up",
		"prepare": "husky",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@okfit/plugin": "^0.4.5",
		"@savvy-web/silk": "^4.2.6",
		"@vitest-agent/plugin": "^4.1.6"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
			"onFail": "warn"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.9.0",
				"onFail": "ignore"
			}
		]
	}
}
