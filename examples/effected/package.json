{
	"name": "@example/effected",
	"version": "0.0.0",
	"private": true,
	"description": "An example of configuring the rolldown-pnpm-config plugin with effected package build",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/rolldown-pnpm-config.git",
		"directory": "examples/effected"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"pnpm:export": "rolldown-pnpm-config export --dry-run",
		"pnpm:preview": "rolldown-pnpm-config preview",
		"pnpm:up": "rolldown-pnpm-config upgrade pnpm-config.ts --dry-run",
		"prepare": "turbo run build",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effected/plugin": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"rolldown-pnpm-config": "workspace:*",
		"typescript": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
